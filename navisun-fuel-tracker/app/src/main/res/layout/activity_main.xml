<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_card"
        android:elevation="8dp"
        app:title="VW Polo 2010 · Yakıt Takibi"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title" />

    <!-- Tab Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@color/bg_card"
        android:elevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab_drive"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="SÜRÜŞ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/text_primary"
            android:stateListAnimator="@null"
            app:cornerRadius="0dp"
            app:backgroundTint="@color/accent"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab_fuel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="YAKIT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/text_primary"
            android:stateListAnimator="@null"
            app:cornerRadius="0dp"
            app:backgroundTint="@color/bg_secondary"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

    </LinearLayout>

    <!-- ViewFlipper -->
    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- [0] SÜRÜŞ Tab Content -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary">

            <!-- Trip status - top center -->
            <TextView
                android:id="@+id/tv_trip_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_status_idle"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Speed number - floats between status and bottom block -->
            <TextView
                android:id="@+id/tv_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="72sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toBottomOf="@id/tv_trip_status"
                app:layout_constraintBottom_toTopOf="@id/tv_kmh"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0.5" />

            <TextView
                android:id="@+id/tv_kmh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:textSize="18sp"
                android:textColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tv_speed"
                app:layout_constraintBottom_toTopOf="@id/tv_active_fuel_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Aktif Yakıt label - above toggle buttons -->
            <TextView
                android:id="@+id/tv_active_fuel_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aktif Yakıt"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp"
                app:layout_constraintBottom_toTopOf="@id/fuel_toggle_row"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- LPG / BENZİN toggle row -->
            <LinearLayout
                android:id="@+id/fuel_toggle_row"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="10dp"
                app:layout_constraintBottom_toTopOf="@id/btn_trip_history"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lpg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="LPG"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="#0288d1"
                    app:cornerRadius="10dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_benzin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="BENZİN"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="#37474f"
                    app:cornerRadius="10dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            </LinearLayout>

            <!-- Sürüş Geçmişi button - pinned to bottom -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_trip_history"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="14dp"
                android:text="Sürüş Geçmişi"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/bg_card"
                app:cornerRadius="12dp"
                app:strokeColor="@color/text_secondary"
                app:strokeWidth="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- [1] YAKIT Tab Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_primary"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Yakıt Tipi Filtre Butonları -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fuel_filter_all"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="HEPSİ"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/accent"
                        app:cornerRadius="10dp"
                        android:stateListAnimator="@null"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fuel_filter_lpg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:text="LPG"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/bg_secondary"
                        app:cornerRadius="10dp"
                        android:stateListAnimator="@null"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_fuel_filter_benzin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="BENZİN"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/bg_secondary"
                        app:cornerRadius="10dp"
                        android:stateListAnimator="@null"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

                </LinearLayout>

                <!-- Stats Grid: Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="0dp">

                    <!-- Son Tüketim Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SON TÜKETİM"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/tv_last_consumption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/text_primary"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="L/100km"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Ortalama Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ORTALAMA"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/tv_avg_consumption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/text_primary"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="L/100km"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Stats Grid: Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <!-- Toplam Maliyet Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOPLAM MALİYET"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/tv_total_cost"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/text_primary"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₺"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Toplam KM Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="6dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center_horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOPLAM KM"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />

                            <TextView
                                android:id="@+id/tv_total_km"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/text_primary"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="km"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Yakıt Ekle button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_fuel"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginBottom="12dp"
                    android:text="+ Yakıt Ekle"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="14dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

                <!-- Yakıt Geçmişi button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fuel_history"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="12dp"
                    android:text="Yakıt Geçmişi"
                    android:textSize="17sp"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/bg_card"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/text_secondary"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

                <!-- İstatistikler button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_stats"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="İstatistikler"
                    android:textSize="17sp"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/bg_card"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/text_secondary"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

            </LinearLayout>

        </ScrollView>

    </ViewFlipper>

</LinearLayout>
